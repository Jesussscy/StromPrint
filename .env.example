# --- Backend (FastAPI / Vercel serverless function) ---
STORMPRINT_API_KEY=sp_live_replace_with_a_long_random_secret
STORMPRINT_KEY_SALT=replace-with-a-random-static-salt
STORMPRINT_ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:3000
ENV=production

# --- Frontend (Next.js, exposed to the browser) ---
# Must match STORMPRINT_API_KEY above.
NEXT_PUBLIC_STORMPRINT_API_KEY=sp_live_replace_with_a_long_random_secret

# --- Open-Meteo API ---
# API gratuita, sin registro requerido: https://api.open-meteo.com
# No se necesita configurar ninguna key. El backend la consulta directamente.
# Attribution: CC BY 4.0 (https://open-meteo.com/)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Notificaciones por Email (opcional) ---
# Si no se configuran, el servicio salta el canal email sin fallar.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# --- Webhook Telegram/Discord (opcional) ---
# Si no se configura, el servicio salta el canal webhook sin fallar.
WEBHOOK_URL=

# --- Vercel (auto-configured) ---
# VERCEL=1                    (set automatically by Vercel)
# VERCEL_ENV=production       (set automatically by Vercel)
# VERCEL_URL=xxx.vercel.app   (set automatically by Vercel)
